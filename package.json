{
  "name": "batch-transmitter-desktop",
  "version": "1.0.8",
  "private": true,
  "description": "Local EVM batch arbitrary transaction transmitter",
  "author": "Local Tools",
  "main": "src/main.cjs",
  "dependencies": {
    "ethers": "6.17.0",
    "ws": "8.21.0",
    "exceljs": "4.4.0",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "global-agent": "4.1.3",
    "solc": {
      "tmp": "0.2.7"
    }
  },
  "productName": "Batch Transmitter Desktop",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "smoke": "electron . --verify-startup",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "artifactName": "Batch-Transmitter-Desktop-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "license": "MIT"
}
